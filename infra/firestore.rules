// Dev-friendly Firestore rules (NOT FOR PRODUCTION)
// Purpose: temporarily allow the admin UI in this repo to read/write the
// `products` and `sales` collections while you configure proper auth & rules.
// WARNING: These rules are intentionally permissive. Revert to a secure
// policy before deploying to production.

service cloud.firestore {
  match /databases/{database}/documents {

    // Products: allow reads for dev, but prevent writes/creates if a tombstone exists.
    // This prevents re-creating deleted products from any client or tool.
    match /products/{productId} {
      allow read: if true;
      // Allow writes only for admin users and only when there is no tombstone.
      // Deletions (request.resource == null) are allowed so admins can remove docs.
      allow write: if request.auth != null
                    && request.auth.token.admin == true
                    && (request.resource == null || !exists(/databases/$(database)/documents/deleted_products/$(productId)));
    }

    // Tombstones collection: allow admin writes so server/tools can register deletions.
    match /deleted_products/{productId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Allow full read/write on sales for development/testing only
    match /sales/{saleId} {
      allow read, write: if true;
    }

    // Allow full read/write on variants for development/testing only
    // (If you store per-product color/size docs in a `variants` collection)
    match /variants/{variantId} {
      allow read, write: if true;
    }

    // Orders (dev-only)
    match /orders/{orderId} {
      allow read, write: if true;

      // Items subcollection
      match /items/{itemId} {
        allow read, write: if true;
      }

      // Tracking subcollection
      match /tracking/{trackingId} {
        allow read, write: if true;
      }
    }

    // Accounts collection: allow reads/writes only for users with admin claim
    // In development this permits the admin UI to list and manage accounts.
    // Check the custom token contains `admin: true` in `request.auth.token`.
    match /accounts/{accountId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Users collection: admin-only access for development
    // The accounts UI listens to `users` to show user profiles; allow access
    // when the signed-in user's ID token contains the admin claim.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // By default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
