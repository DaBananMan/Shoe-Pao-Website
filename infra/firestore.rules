// Dev-friendly Firestore rules (NOT FOR PRODUCTION)
// Purpose: temporarily allow the admin UI in this repo to read/write the
// `products` and `sales` collections while you configure proper auth & rules.
// WARNING: These rules are intentionally permissive. Revert to a secure
// policy before deploying to production.

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow full read/write on products for development/testing only
    match /products/{productId} {
      allow read, write: if true;
    }

    // Allow full read/write on sales for development/testing only
    match /sales/{saleId} {
      allow read, write: if true;
    }

    // Allow full read/write on variants for development/testing only
    // (If you store per-product color/size docs in a `variants` collection)
    match /variants/{variantId} {
      allow read, write: if true;
    }

    // Orders (dev-only)
    match /orders/{orderId} {
      allow read, write: if true;

      // Items subcollection
      match /items/{itemId} {
        allow read, write: if true;
      }

      // Tracking subcollection
      match /tracking/{trackingId} {
        allow read, write: if true;
      }
    }

    // Accounts (dev-only)
    // NOTE: This block is intentionally permissive on reads for local development
    // so admin UI pages can use client-side onSnapshot during testing. Remove or
    // tighten this rule before deploying to production.
    match /accounts/{accountId} {
      // allow clients to list/read account documents during development
      allow read: if true;

      // allow writes only for authenticated admin users (via custom claim)
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // By default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
